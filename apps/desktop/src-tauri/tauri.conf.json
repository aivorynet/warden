{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Aivory Warden",
  "version": "2026.11.0",
  "identifier": "net.aivory.warden.desktop",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Aivory Warden",
        "width": 1280,
        "height": 820,
        "minWidth": 720,
        "minHeight": 560
      }
    ],
    "security": {
      "csp": "default-src 'none'; script-src 'self'; style-src 'self'; font-src 'self'; img-src 'self' data:; connect-src ipc: http://ipc.localhost; base-uri 'none'; form-action 'none'; frame-ancestors 'none'"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico", "icons/icon.png"],
    "linux": {
      "deb": {
        "files": {
          "/usr/share/polkit-1/actions/net.aivory.warden.unlock.policy": "../../../packaging/linux/net.aivory.warden.unlock.policy"
        }
      }
    }
  }
}
