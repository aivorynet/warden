{
  "manifest_version": 3,
  "name": "Save to Warden",
  "version": "2026.11.0",
  "description": "Send a token from a provider page to your Aivory Warden inbox. Capture runs only when you click.",
  "key": "",
  "minimum_chrome_version": "116",
  "permissions": ["activeTab", "scripting", "contextMenus", "nativeMessaging"],
  "action": { "default_title": "Save to Warden", "default_popup": "popup.html" },
  "background": { "service_worker": "background.js", "type": "module" }
}
