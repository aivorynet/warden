{
  "manifest_version": 3,
  "name": "Save to Warden",
  "version": "2026.11.1",
  "description": "Send a token from a provider page to your Aivory Warden inbox. Capture runs only when you click.",
  "key": "",
  "minimum_chrome_version": "116",
  "permissions": [
    "activeTab",
    "scripting",
    "contextMenus",
    "nativeMessaging"
  ],
  "action": {
    "default_title": "Save to Warden",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/16.png",
      "32": "icons/32.png",
      "48": "icons/48.png",
      "128": "icons/128.png"
    }
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "icons": {
    "16": "icons/16.png",
    "32": "icons/32.png",
    "48": "icons/48.png",
    "128": "icons/128.png"
  }
}
